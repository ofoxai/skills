# Local dev/test only — do not commit real values. Copy to .env and fill in.
# The shipped skill script (ofox-video.sh) reads only the shell environment
# and does not depend on this file.

# Ofox API key for local testing
OFOX_API_KEY=

# Ofox video API base URL (from ofox.ai/docs/api/videos)
OFOX_API_BASE_URL=https://api.ofox.ai/v1

# Page to get an API key — used in SKILL.md to point users to sign up
OFOX_GET_KEY_URL=https://app.ofox.ai
